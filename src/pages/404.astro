---
import Base from "../layouts/Base.astro";
---
<Base banner={false} title="Seite nicht gefunden | Praxisporto" description="Diese Seite gibt es nicht." noindex>
  <section class="herobox pad">
    <div class="wrap stack center" style="align-items:center">
      <img src="/brand/icon-voll.svg" alt="" width="120" height="120" />
      <h1>Diese Seite ist wohl nicht zugestellt worden.</h1>
      <p class="lead">Die Adresse stimmt nicht oder die Seite wurde verschoben.</p>
      <div class="actions" style="justify-content:center"><a class="btn" href="/">Zur Startseite</a><a class="link" href="/ratgeber/">Zum Ratgeber</a></div>
    </div>
  </section>
</Base>
