---
// Hero sign-up: just the e-mail address. Same endpoint as the demo page.
import { DEMO_REQUEST_URL } from "../config";
---
<form class="stack hero-form" data-signup data-endpoint={DEMO_REQUEST_URL} data-device="desktop" data-source="hero" novalidate>
  <div class="inline-form">
    <label class="sr-only" for="hero-email">E-Mail der Praxis</label>
    <input id="hero-email" name="email" type="email" autocomplete="email" placeholder="E-Mail der Praxis" required maxlength="254" />
    <button class="btn" type="submit">Demo ausprobieren</button>
  </div>
  <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <p class="form-status" role="status" aria-live="polite"></p>
</form>
<script src="../scripts/forms.ts"></script>
