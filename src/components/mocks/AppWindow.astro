---
// The print app with an order opened from the PVS, as a sketch: only the essentials are readable.
---
<div class="appwin shadow" role="img" aria-label="Druck-App mit geöffnetem Auftrag für Erika Mustermann, Standardbrief gewählt, Knopf Kaufen und drucken">
  <div class="bar"><i></i><i></i><i></i></div>
  <div class="body">
    <div class="side">
      <b>+</b>
      <span class="on"><u style="width:70%"></u></span>
      <span><u style="width:55%"></u></span>
      <span><u style="width:62%"></u></span>
    </div>
    <div class="main">
      <div class="hd"><strong>Erika Mustermann</strong><em></em></div>
      <div class="fields"><span><u style="width:45%"></u></span><span class="half"><u style="width:60%"></u></span><span class="half"><u style="width:40%"></u></span></div>
      <div class="pills"><span class="on">Standardbrief · 0,95 €</span><span></span><span></span></div>
      <div class="act"><span class="buy">Kaufen &amp; drucken</span><span class="ghost"></span><span class="ghost drop"></span></div>
    </div>
  </div>
</div>
