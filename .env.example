# Public address of the website (canonical links, sitemap, Open Graph)
SITE_URL=https://www.praxisporto.de
# Address of the Praxisporto app (login link)
PUBLIC_APP_URL=https://app.praxisporto.de
# Optional: endpoint for demo requests; default {PUBLIC_APP_URL}/api/v1/public/demo-requests
PUBLIC_DEMO_REQUEST_URL=
PUBLIC_CONTACT_MAIL=
# Cookie-free analytics (Plausible). Empty = no tracking script, no events
PUBLIC_ANALYTICS_DOMAIN=
PUBLIC_ANALYTICS_SRC=
